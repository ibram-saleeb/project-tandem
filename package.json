{
  "name": "project-tandem",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "vitest run && playwright test",
    "preview:capture": "node scripts/capture-preview.js",
    "preview": "vite preview",
    "setup:hooks": "git config core.hooksPath .githooks",
    "check:governance": "node scripts/verify-governance.js",
    "pre-commit": "node scripts/verify-governance.js --stage pre-commit",
    "pre-push": "node scripts/verify-governance.js --stage pre-push",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name=project-tandem",
    "build:twa": "npx -y @bubblewrap/cli build --manifest=twa-manifest.json"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@bubblewrap/core": "^1.25.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
